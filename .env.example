NODE_ENV=development
TELEGRAM_TOKEN=replace_me
TELEGRAM_UPDATE_MODE=polling

# Dedicated Resplitter HTTP port (health, readiness, metrics and webhook).
HOST=127.0.0.1
PORT=43127
TRUSTED_PROXY_IPS=
MINI_APP_URL=https://your-resplitter.example.com
ENABLE_DEMO_COMMAND=true
# /metrics is disabled until a secret is configured. Never publish this token.
METRICS_TOKEN=

# Required only when TELEGRAM_UPDATE_MODE=webhook.
WEBHOOK_BASE_URL=https://bot.example.com
WEBHOOK_SECRET=replace_with_a_long_random_value

RECEIPT_PROCESSOR_API=https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText
API_KEY=replace_me
API_FOLDER_KEY=replace_me
OCR_AUTH_SCHEME=Api-Key
OCR_ALLOW_DATA_LOGGING=false
OCR_FALLBACK_ENABLED=true
# At most one additional OCR pass for incomplete/ambiguous recognition (extra provider request).
OCR_ENHANCED_RETRY=true
OCR_TIMEOUT_MS=20000
OCR_MAX_CONCURRENT=2
OCR_MAX_IMAGE_BYTES=12582912

STATE_FILE=data/runtime-state.json
DATABASE_FILE=data/resplitter.sqlite
TEMP_DIR=data/tmp
SESSION_TTL_MS=86400000
MAX_RECEIPT_ITEMS=100
MAX_ITEM_NAME_LENGTH=120
MAX_PEOPLE_COUNT=100
