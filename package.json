{
  "name": "resplitter",
  "version": "2.0.0",
  "private": true,
  "description": "Production-oriented Telegram bot for receipt recognition and bill splitting",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "dev:web": "vite --config web/vite.config.mts",
    "dev": "ts-node src/index.ts",
    "start": "node dist/src/index.js",
    "test": "npm run build:server && node --test \"dist/tests/*.test.js\"",
    "lint": "eslint .",
    "backup": "node scripts/backup.cjs",
    "test:start": "powershell -NoProfile -File scripts/Start-Test.ps1",
    "test:start:ngrok": "powershell -NoProfile -File scripts/Start-Test.ps1 -TunnelProvider ngrok",
    "test:stop": "powershell -NoProfile -File scripts/Stop-Test.ps1",
    "test:restart:bot": "powershell -NoProfile -File scripts/Restart-TestBot.ps1",
    "format": "prettier --write \"{src,tests}/**/*.ts\" \"web/**/*.{ts,tsx,mts,css,html,json}\" \"docs/*.md\" \"*.{json,md,mjs}\"",
    "format:check": "prettier --check \"{src,tests}/**/*.ts\" \"web/**/*.{ts,tsx,mts,css,html,json}\" \"docs/*.md\" \"*.{json,md,mjs}\"",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.13.0 <23"
  },
  "license": "ISC",
  "dependencies": {
    "axios": "^1.19.0",
    "dotenv": "^17.4.2",
    "node-telegram-bot-api": "^1.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sharp": "^0.35.4",
    "tesseract.js": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "eslint": "^10.10.0",
    "prettier": "^3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.0"
  },
  "packageManager": "npm@10.9.2"
}
